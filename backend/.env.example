# FactoryOS AI — Environment Configuration
# ==========================================

# Database Engine: 'sqlite' (local development) | 'postgresql' (production)
DB_ENGINE=sqlite

# PostgreSQL Production Database
DB_NAME=factoryos_ai
DB_USER=factoryos_user
DB_PASSWORD=factoryos_password
DB_HOST=localhost
DB_PORT=5432

# Django Settings
DJANGO_SECRET_KEY=django-insecure-factoryos-ai-production-grade-foundation-phase1-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS for Flutter Web Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000

# FactoryOS AI — LLM & Autonomous Agent Provider Configuration
# ==============================================================
# Provider Mode: 'hybrid' (default: LLM with deterministic fallback) | 'llm' (strict) | 'deterministic' (zero-key heuristic)
FACTORYOS_AI_PROVIDER=hybrid
FACTORYOS_AI_MODEL=gpt-4o-mini
FACTORYOS_AI_API_KEY=
FACTORYOS_AI_BASE_URL=https://api.openai.com/v1
FACTORYOS_AI_TIMEOUT_SECONDS=30
FACTORYOS_AI_MAX_RETRIES=2

